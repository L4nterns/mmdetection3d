# ==============================================================================
# 1. 宿主机目录与 Docker 挂载
# ------------------------------------------------------------------------------
# Compose 挂载关系：
#   LABELCLOUD_DIR  -> /workspace/labelCloud:ro
#   INFER_DIR       -> /workspace/infer:ro
#   CHECKPOINTS_DIR -> /workspace/checkpoints:ro
#   DATA_DIR        -> /workspace/mmdetection3d/data
#   OUTPUT_DIR      -> /workspace/mmdetection3d/output
# 训练/推理命令在容器内运行时，权重路径要写容器路径；宿主机直接运行时写宿主机路径。
# 约定：
# - LABELCLOUD_DIR、INFER_DIR、CHECKPOINTS_DIR、DATA_DIR、OUTPUT_DIR 是 Compose 挂载源，填写宿主机路径。
# - PRETRAINED_MODEL、RESUME_CKPT、INFER_CFG_FILE、INFER_CKPT、INPUT_DIR 等由容器内程序读取；
#   Docker 运行时填写 /workspace/... 容器路径。
LABELCLOUD_DIR=./labelCloud
INFER_DIR=./infer
CHECKPOINTS_DIR=./checkpoints
DATA_DIR=./data
OUTPUT_DIR=./output

# ==============================================================================
# 2. 模型、数据转换与生成配置
# ------------------------------------------------------------------------------
# MODEL：生效于转换、训练、推理。
#   tr3d/fcaf3d：稠密 XYZRGB 场景点云路线，使用 MinkowskiEngine，不使用 GT database。
#   pv_rcnn/pointpillars：LiDAR-style 基线，可使用 GT database/ObjectSample。
MODEL=tr3d

# EXTRA_TAG：给生成配置和 work_dir 追加后缀，用于同一模型多组实验。
EXTRA_TAG=

# CFG_FILE：训练/转换显式指定配置文件；为空时使用 data/labelcloud/cfgs/labelcloud_<MODEL>.py。
# INFER_CFG_FILE：推理显式指定配置文件，必须指向已确认可用的固定推理配置。
# 改了 AUG_MODE、POINT_FEATURES、SAMPLE_POINTS、SPARSE_VOXEL_SIZE 或 GT_DATABASE 后，
# 需要重新执行 pipeline/convert/reconvert 生成配置；只跑 train/retrain 会复用旧配置。
CFG_FILE=

# OUT_DIR：转换产物根目录，包含 points、infos、cfgs、work_dirs 等。
OUT_DIR=data/labelcloud

# 训练/验证划分。TRAIN_RATIO 和 VAL_RATIO 会按二者总和归一化；0.8/0.2 等价于 8/2。
TRAIN_RATIO=0.8
VAL_RATIO=0.2
SPLIT_SEED=42

# ==============================================================================
# 3. 输入特征、采样与数据增强
# ------------------------------------------------------------------------------
# POINT_FEATURES：生成配置中的点特征维度。
#   xyzrgb：x/y/z/r/g/b，默认值；tr3d/fcaf3d 只能使用这个模式。
#   xyzi：x/y/z/r，仅用于 pv_rcnn/pointpillars 四通道权重实验或消融。
POINT_FEATURES=xyzrgb

# SAMPLE_POINTS：每帧点数采样上限；>0 时写入生成配置，-1 表示不采样。
#   tr3d：训练使用 TR3DPointSample，推理使用 PointSample。
#   fcaf3d/pv_rcnn/pointpillars：使用 PointSample。
SAMPLE_POINTS=500000

# SPARSE_VOXEL_SIZE：只对 tr3d/fcaf3d 生效，控制 sparse RGB backbone 的体素尺寸。
# 稠密大场景 OOM 时可适当调大，例如 0.02；pv_rcnn/pointpillars 不读取此项。
SPARSE_VOXEL_SIZE=0.02

# MIN_BOX_DIM：转换阶段过滤任意边长小于该阈值的 3D 框；<=0 表示不按边长过滤。
# MIN_POINTS_IN_GT：转换阶段过滤内部点数小于该阈值的 3D 框；<=0 表示不按点数过滤。
# 这两个参数用于拦截 labelCloud 标注转换后的退化框，避免无点 GT 或近零尺寸框进入训练。
MIN_BOX_DIM=0.0001
MIN_POINTS_IN_GT=1

# AUG_MODE：生成训练 pipeline 时生效。
#   full：
#     pv_rcnn/pointpillars -> ObjectSample + 翻转 + 旋转 + 尺度扰动。
#     tr3d/fcaf3d         -> 场景级翻转 + 小角度旋转/平移/尺度扰动，不做 ObjectSample。
#   safe：
#     所有模型 -> 只保留尺度扰动；不做 ObjectSample。
#   none：
#     所有模型 -> 不做增强。
AUG_MODE=full

# GT_DATABASE：只对 pv_rcnn/pointpillars 有效。
#   auto：仅 AUG_MODE=full 时创建并引用 labelCloud GT database。
#   on：强制创建并引用；tr3d/fcaf3d 会直接报错。
#   off：不创建、不引用。
# tr3d/fcaf3d 无论 AUG_MODE 如何都不使用 GT database。
GT_DATABASE=auto

# GT database 分块与限点参数；仅在 pv_rcnn/pointpillars 且实际创建 GT database 时生效。
# TARGET_ELEMENTS 近似控制每个分块的点元素总量，MIN/MAX_CHUNK_SIZE 控制分块样本数边界。
# MAX_POINTS=0 表示单个目标裁切点云不额外限点。
GT_DATABASE_TARGET_ELEMENTS=4000000
GT_DATABASE_MIN_CHUNK_SIZE=50000
GT_DATABASE_MAX_CHUNK_SIZE=500000
GT_DATABASE_MAX_POINTS=0

# ==============================================================================
# 4. 训练运行参数
# ------------------------------------------------------------------------------
# BATCH_SIZE：总 batch size。
#   auto：每张 GPU 约 2 个样本。
#   整数：多 GPU 时会均分到每张 GPU，必须能被 GPU 数整除。
# 默认 4 对多卡更稳；单卡显存不足时建议改为 1 或 2。
BATCH_SIZE=4

# WORKERS：每个 dataloader 的 worker 数；0 会同步关闭 persistent_workers。
WORKERS=2

# NUM_GPUS：auto 使用当前可见 GPU 数；也可写 1、2、4 等整数。
NUM_GPUS=auto

# MASTER_PORT：多卡 torch.distributed 端口。
MASTER_PORT=18888

# EPOCHS：写入生成配置，并在训练 wrapper 里覆盖 train_cfg/param_scheduler。
EPOCHS=80

# TRAIN_REPEAT_TIMES：训练集重复次数。
#   auto：tr3d/fcaf3d 使用 5，pv_rcnn/pointpillars 使用 2。
#   整数：显式覆盖 RepeatDataset.times；只影响训练采样次数，不改变转换产物。
TRAIN_REPEAT_TIMES=auto

# VAL_INTERVAL：每隔多少个 epoch 做一次验证；会自动限制到不超过 EPOCHS。
VAL_INTERVAL=5

# TRAIN_AMP：训练时启用 MMEngine AMP；默认关闭。
# TRAIN_AMP_DTYPE：训练 AMP 精度，支持 fp16 或 bf16。
#   fp16 使用动态 loss scale；bf16 不使用 loss scale，要求 PyTorch/CUDA/GPU 支持 bf16。
TRAIN_AMP=false
TRAIN_AMP_DTYPE=fp16

# TRAIN_LR：生成配置中的 AdamW 基础学习率。
# 默认 0.0003 更适合从 ScanNet 等外部权重微调到 labelCloud 小数据。
# TRAIN_LR_PEAK_RATIO：第一段 CosineAnnealingLR 的峰值倍率；1.0 表示不把 LR 拉高。
# 如需复现实验性 OneCycle 风格升 LR，可显式设为 >1；不建议默认升到 10 倍。
TRAIN_LR=0.0003
TRAIN_LR_PEAK_RATIO=1.0

# WORK_DIR：训练输出目录；为空时使用 <OUT_DIR>/work_dirs/labelcloud_<MODEL>[_EXTRA_TAG]。
WORK_DIR=

# PYTORCH_CUDA_ALLOC_CONF：CUDA allocator 配置；碎片化严重时可设 max_split_size_mb:128。
PYTORCH_CUDA_ALLOC_CONF=

# ==============================================================================
# 5. 训练权重、续训与推理权重
# ------------------------------------------------------------------------------
# 微调需要提前下载预训练权重到宿主机 CHECKPOINTS_DIR。
# 常用下载地址：
#   tr3d ScanNet 18 类：
#   https://download.openmmlab.com/mmdetection3d/v1.1.0_models/tr3d/tr3d_1xb16_scannet-3d-18class/tr3d_1xb16_scannet-3d-18class.pth
#   fcaf3d ScanNet 18 类：
#   https://download.openmmlab.com/mmdetection3d/v1.0.0_models/fcaf3d/fcaf3d_8x2_scannet-3d-18class/fcaf3d_8x2_scannet-3d-18class_20220805_084956.pth
#   pointpillars KITTI 3 类：
#   https://download.openmmlab.com/mmdetection3d/v1.0.0_models/pointpillars/hv_pointpillars_secfpn_6x8_160e_kitti-3d-3class/hv_pointpillars_secfpn_6x8_160e_kitti-3d-3class_20220301_150306-37dc2420.pth
#   pv_rcnn KITTI 3 类：
#   https://download.openmmlab.com/mmdetection3d/v1.1.0_models/pv_rcnn/pv_rcnn_8xb2-80e_kitti-3d-3class/pv_rcnn_8xb2-80e_kitti-3d-3class_20221117_234428-b384d22f.pth
#
# PRETRAINED_MODEL：训练初始化权重，写入 cfg.load_from；不会恢复 epoch/optimizer/scheduler。
# 不用于推理。权重建议放到宿主机 CHECKPOINTS_DIR=./checkpoints。
# Docker 训练示例：PRETRAINED_MODEL=/workspace/checkpoints/tr3d_1xb16_scannet-3d-18class.pth
# 宿主机直接运行示例：PRETRAINED_MODEL=./checkpoints/tr3d_1xb16_scannet-3d-18class.pth
PRETRAINED_MODEL=

# RESUME_CKPT：训练续训 checkpoint，传给 tools/train.py --resume。
#   auto：仅 train 服务和 --skip-convert 训练入口生效，由 MMEngine 从 WORK_DIR 自动恢复最新 checkpoint。
#   空值：不续训，从 PRETRAINED_MODEL 或当前配置从头开始训练。
#   具体路径：从指定 checkpoint 续训，恢复 epoch/optimizer/scheduler。
#   pipeline/prepare 等完整转换入口会忽略 auto，避免新数据准备后误续训旧输出。
#   retrain 服务只在本次容器运行环境中把 RESUME_CKPT 覆盖为空，不会修改 .env。
# Docker 路径示例：RESUME_CKPT=/workspace/checkpoints/epoch_20.pth
# 宿主机直接运行示例：RESUME_CKPT=./checkpoints/epoch_20.pth
RESUME_CKPT=auto

# INFER_CFG_FILE / INFER_CKPT：Docker CLI/HTTP 推理加载的固定配置和 checkpoint。
# 已确认可用的配置和 checkpoint 应放到固定目录，避免训练重建 cfgs/work_dirs 时影响推理。
# Docker 默认推理路径：
#   宿主机 checkpoints/deploy/tr3d_current/config.py -> 容器 /workspace/checkpoints/deploy/tr3d_current/config.py
#   宿主机 checkpoints/deploy/tr3d_current/model.pth -> 容器 /workspace/checkpoints/deploy/tr3d_current/model.pth
# INFER_CKPT 必须使用明确 checkpoint 路径。
INFER_CFG_FILE=/workspace/checkpoints/deploy/tr3d_current/config.py
INFER_CKPT=/workspace/checkpoints/deploy/tr3d_current/model.pth

# ==============================================================================
# 6. CLI 推理与 HTTP 推理服务
# ------------------------------------------------------------------------------
# INPUT_DIR：CLI 推理输入目录。Docker 默认读取 /workspace/infer；宿主机直接运行可改为 ./infer。
INPUT_DIR=/workspace/infer

# SCORE_THRESH：预测框写出阈值；HTTP 请求未传 score_thresh 时使用此默认值。
SCORE_THRESH=0.3

# PRED_OUT_DIR：CLI 推理输出目录；为空时使用 output/predictions/<cfg_stem>。
PRED_OUT_DIR=

# SKIP_EXISTING：CLI 推理是否跳过已有 predictions.json 的场景；取值 1/true/yes/on 开启。
SKIP_EXISTING=

# DEVICE：服务进程使用的 torch device。
# 多 GPU HTTP 部署时建议用 CUDA_VISIBLE_DEVICES 绑定物理卡，进程内仍写 cuda:0。
DEVICE=cuda:0

# INFER_AMP：CLI/HTTP 推理时启用 CUDA autocast；默认关闭。
# INFER_AMP_DTYPE：推理 AMP 精度，支持 fp16 或 bf16；bf16 需要当前 PyTorch/CUDA/GPU 支持。
INFER_AMP=false
INFER_AMP_DTYPE=fp16

# HTTP_HOST/HTTP_PORT：HTTP 推理服务监听地址和端口。
HTTP_HOST=0.0.0.0
HTTP_PORT=8011

# HTTP_AUTH_TOKEN：为空则不鉴权；非空时 /v1/infer 需要 Authorization: Bearer <token>。
HTTP_AUTH_TOKEN=

# HTTP_CROP：HTTP 请求未传 crop 时是否默认生成对象裁切 PCD；默认关闭，减少网络传输。
# pipeline 等下游需要对象点云时，请在请求表单中传 crop=true。
HTTP_CROP=false

# ==============================================================================
# 7. 镜像构建参数
# ------------------------------------------------------------------------------
# 这些变量只影响 docker compose build，不影响训练/推理运行时语义。
BASE_IMAGE=pytorch/pytorch:1.13.1-cuda11.6-cudnn8-devel
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
MMENGINE_VERSION=0.10.7
MMCV_VERSION=2.1.0
MMDET_VERSION=3.2.0
MINKOWSKI_ENGINE_VERSION=0.5.4
TORCH_CUDA_ARCH_LIST=8.6
